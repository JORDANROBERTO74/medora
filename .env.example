# Local dev: copy to .env.local and fill in.
# Supabase project: Authentication -> Providers -> Email (disable "Confirm email"
# for this app; set minimum password length 8 + lower/upper/digit) and
# Authentication -> URL Configuration (site + redirect URLs).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app origin used in Supabase email links. Required in production
# (the app refuses to build recovery links from request headers there).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: activates distributed rate limiting. Without these the app falls
# back to an in-memory limiter (fine for local dev, per-instance in serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
